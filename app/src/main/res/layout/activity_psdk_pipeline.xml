<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <include
        android:id="@+id/layout_title"
        layout="@layout/title_layout" />

    <TextView
        android:id="@+id/tv_msg_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/layout_title"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginLeft="@dimen/dp_10"
        android:text="接受到数据:"/>

    <TextView
        android:id="@+id/tv_receive_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tv_msg_title"
        app:layout_constraintLeft_toLeftOf="@id/tv_msg_title"
        android:layout_marginTop="@dimen/dp_10"
        android:textColor="@color/colorAccent"
        android:text=""/>


    <Button
        android:id="@+id/tv_send_msg"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_receive_msg"
        app:layout_constraintLeft_toLeftOf="@id/tv_msg_title"
        android:layout_marginTop="@dimen/dp_40"
        android:text="发送数据:"/>

    <TextView
        android:id="@+id/tv_test_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/tv_send_msg"
        app:layout_constraintBottom_toBottomOf="@id/tv_send_msg"
        app:layout_constraintLeft_toRightOf="@id/tv_send_msg"
        android:layout_marginLeft="@dimen/dp_10"
        android:text="0x01,0x02,0x03,0x04,0x05,0x10,0x20,0x30,0x40,0x66"/>

</androidx.constraintlayout.widget.ConstraintLayout>