<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/layout_title"
        layout="@layout/title_layout" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/set_control_hand_button"
                    android:onClick="onClick"
                    android:text="控制手设置" />
                <Button
                    android:text="获取控制手"
                    android:id="@+id/get_control_hand_button"
                    android:onClick="onClick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/control_hand_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <Button
                android:text="开始对频"
                android:id="@+id/start_pairing_button"
                android:onClick="onClick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/get_rc_version_button"
                    android:onClick="onClick"
                    android:text="获取版本号"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/get_rc_sn_button"
                    android:onClick="onClick"
                    android:text="获取遥控器SN"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/get_multi_control_mode_button"
                    android:onClick="onClick"
                    android:text="获取多控模式"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/set_multi_control_mode_button"
                    android:onClick="onClick"
                    android:text="设置多控模式"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/get_drone_list_button"
                    android:onClick="onClick"
                    android:text="获取多控飞机列表"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/get_rc_list_button"
                    android:onClick="onClick"
                    android:text="获取多控遥控器列表"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/set_drone_control_enable_button"
                    android:onClick="onClick"
                    android:text="设置多控飞机控制权开关"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/get_drone_control_enable_button"
                    android:onClick="onClick"
                    android:text="获取多控飞机控制权开关"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/set_drone_living_enable_button"
                    android:onClick="onClick"
                    android:text="设置多控飞机视频流开关"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/get_drone_living_enable_button"
                    android:onClick="onClick"
                    android:text="获取多控飞机视频流开关"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/set_continue_send_rc_control_mid_value_enable_button"
                    android:onClick="onClick"
                    android:text="设置发送摇杆中值开关"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/get_continue_send_rc_control_mid_value_enable_button"
                    android:onClick="onClick"
                    android:text="获取发送摇杆中值开关"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/set_drtk_mode_button"
                    android:onClick="onClick"
                    android:text="设置DRTK模式"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/get_drtk_mode_button"
                    android:onClick="onClick"
                    android:text="获取DRTK模式"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/connect_nps_button"
                    android:onClick="onClick"
                    android:text="请求nps连接"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/rtk_cal_button"
                    android:onClick="onClick"
                    android:text="机库rtk自校准"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/rtk_cal_stop_button"
                    android:onClick="onClick"
                    android:text="停止机库rtk自校准"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/rtk_set_pos_button"
                    android:onClick="onClick"
                    android:text="设置机库rtk位置"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/rtk_get_pos_button"
                    android:onClick="onClick"
                    android:text="获取机库rtk位置"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/drtk_state_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:text="DRTK状态：等待更新"
                android:textColor="#333333"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
